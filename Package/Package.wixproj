<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <OutputName>FramesToMMSpriteResources</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <AppPublishDir>$(MSBuildProjectDirectory)\..\FramesToMMSpriteResources\bin\$(Configuration)\net10.0-windows10.0.22000.0\win-x64\publish\</AppPublishDir>
    <DefineConstants>
			AppPublishDir=$(AppPublishDir)
		</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <ProjectReference Include="..\FramesToMMSpriteResources\FramesToMMSpriteResources.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\" />
  </ItemGroup>
  <Target Name="PublishApplication" BeforeTargets="Compile">
    <MSBuild Projects="..\FramesToMMSpriteResources\FramesToMMSpriteResources.csproj" Targets="Publish" Properties="Configuration=$(Configuration);Platform=x64;RuntimeIdentifier=win-x64;PublishDir=$(AppPublishDir)" />
  </Target>
</Project>