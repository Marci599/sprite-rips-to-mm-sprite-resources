<UserControl
    x:Class="FramesToMMSpriteResources.FrameCoordinateEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:FramesToMMSpriteResources"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    IsTabStop="True"
    KeyDown="RootGrid_KeyDown"
    KeyUp="RootGrid_KeyUp">

    <Grid>
        <skia:SKSwapChainPanel
            x:Name="CoordinateCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        <StackPanel
            Margin="-4,10,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Border
                x:Name="AnimationPreviewHostBorder"
                Width="126"
                Height="156"
                MinWidth="126"
                MinHeight="126">
                <Grid>
                    <Border
                        Margin="4,0,0,4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <skia:SKSwapChainPanel
                            x:Name="AnimationPreviewCanvas"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                    </Border>
                    <Border
                        x:Name="PreviewResizeLeftHandle"
                        Width="8"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        PointerEntered="PreviewResizeLeftHandle_PointerEntered"
                        PointerExited="PreviewResizeHandle_PointerExited"
                        PointerMoved="PreviewResizeHandle_PointerMoved"
                        PointerPressed="PreviewResizeLeftHandle_PointerPressed"
                        PointerReleased="PreviewResizeHandle_PointerReleased" />
                    <Border
                        x:Name="PreviewResizeBottomHandle"
                        Height="8"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        PointerEntered="PreviewResizeBottomHandle_PointerEntered"
                        PointerExited="PreviewResizeHandle_PointerExited"
                        PointerMoved="PreviewResizeHandle_PointerMoved"
                        PointerPressed="PreviewResizeBottomHandle_PointerPressed"
                        PointerReleased="PreviewResizeHandle_PointerReleased" />
                    <Border
                        x:Name="PreviewResizeCornerHandle"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        PointerEntered="PreviewResizeCornerHandle_PointerEntered"
                        PointerExited="PreviewResizeHandle_PointerExited"
                        PointerMoved="PreviewResizeHandle_PointerMoved"
                        PointerPressed="PreviewResizeCornerHandle_PointerPressed"
                        PointerReleased="PreviewResizeHandle_PointerReleased" />
                </Grid>
            </Border>
            <Border
                x:Name="FrameRangeBorder"
                Margin="0,-6,0,0"
                Padding="10"
                HorizontalAlignment="Right"
                Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorOnAccentTertiaryBrush}"
                BorderThickness="1"
                CornerRadius="0 0 8 8">
                <Border CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <local:CustomNumberBox
                            x:Name="FromNumberBox"
                            Width="45"
                            MinWidth="0"
                            CornerRadius="4 0 0 4"
                            Maximum="9999"
                            Minimum="0"
                            PlaceholderText="0" />
                        <Border
                            Margin="-1,-1,-1,0"
                            Padding="2"
                            Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderBrush="{ThemeResource TextControlElevationBorderBrush}"
                            BorderThickness="1">
                            <TextBlock
                                Padding="0,0,0,3"
                                VerticalAlignment="Center"
                                Text="-" />
                        </Border>

                        <local:CustomNumberBox
                            x:Name="ToNumberBox"
                            Width="45"
                            MinWidth="0"
                            CornerRadius="0 4 4 0"
                            Maximum="9999"
                            Minimum="0"
                            PlaceholderText="n" />
                    </StackPanel>
                </Border>
            </Border>
        </StackPanel>

        <Border
            Margin="10"
            Padding="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorOnAccentTertiaryBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button HorizontalAlignment="Stretch" Click="CenterOriginButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE777;" />
                        <TextBlock Text="Recenter" />
                    </StackPanel>
                </Button>
                <local:CustomNumberBox
                    x:Name="ZoomNumberBox"
                    Maximum="1800"
                    Minimum="10"
                    PlaceholderText="100" />
            </StackPanel>
        </Border>
        <Border
            Margin="10"
            Padding="14,14,14,14"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorOnAccentTertiaryBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock VerticalAlignment="Center" Text="Previous frame behind" />
                <ToggleSwitch
                    x:Name="ShowPreviousToggleSwitch"
                    MinWidth="0"
                    Margin="0,-8,0,-8" />
            </StackPanel>
        </Border>


        <Border
            x:Name="FramesLoadingBorder"
            AllowFocusOnInteraction="True"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            CornerRadius="0 0 0 0">
            <ProgressRing />
        </Border>
    </Grid>

</UserControl>
